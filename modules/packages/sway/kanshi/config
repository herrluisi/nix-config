profile home {
  output "BOE 0x0BC9 Unknown" mode 2560x1600 position 3840,0 scale 1.5 enable
  output "Ancor Communications Inc BE24A G1LMQS040301" mode 1920x1080 position 1920,0 scale 1 enable
  output "Hewlett Packard HP 23xig 3CM431057J" mode 1920x1080 position 0,0 scale 1 enable
}

profile mirror {
  output "BOE 0x0BC9 Unknown" mode 2560x1600 position 1920,0 scale 1.5 enable
  output "DP-4" position 0,0 enable
  exec wl-present mirror eDP-1 --fullscreen-output DP-4 --fullscreen
}

profile mobile {
  output "BOE 0x0BC9 Unknown" mode 2560x1600 position 0,0 scale 1.0 enable
}

profile lock {
  output "BOE 0x0BC9 Unknown" mode 2560x1600 position 3840,0 scale 1.5 enable
  output "Ancor Communications Inc BE24A G1LMQS040301" disable
  output "Hewlett Packard HP 23xig 3CM431057J" mode 1920x1080 position 0,0 scale 1 enable
}

profile unlock {
  output "BOE 0x0BC9 Unknown" mode 2560x1600 position 3840,0 scale 1.5 enable
  output "Ancor Communications Inc BE24A G1LMQS040301" mode 1920x1080 position 1920,0 scale 1 enable
  output "Hewlett Packard HP 23xig 3CM431057J" mode 1920x1080 position 0,0 scale 1 enable
}
